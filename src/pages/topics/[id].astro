---
import { Badge } from "@/components/starwind/badge";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import TopicDetail from "@/components/TopicDetail.astro";
import { topics, type Topic } from "@/data/topics";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return topics.map((topic, index) => ({
    params: { id: topic.id },
    props: { topic, index },
  }));
}

interface Props {
  topic: Topic;
  index: number;
}

const { topic, index } = Astro.props;
const homeUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const topicsUrl = `${homeUrl}#topics`;
---

<BaseLayout
  title={`${topic.title} 대표 문제 | Algo Roadmap`}
  description={`${topic.title} 대표 문제와 단계별 풀이, 코드 템플릿을 확인하세요.`}
  skipHref="#topic-content"
  skipLabel="상세 풀이로 건너뛰기"
>
  <SiteHeader page="detail" />

  <main id="topic-content" class="mx-auto w-[calc(100%_-_2rem)] max-w-7xl py-12 sm:w-[calc(100%_-_2.5rem)] sm:py-16">
    <a class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-primary" href={topicsUrl}>← 대표 문제 유형으로 돌아가기</a>

    <header class="max-w-4xl py-12 sm:py-16">
      <div class="flex items-center gap-2">
        <span class="font-mono text-xs font-semibold text-muted-foreground">{String(index + 1).padStart(2, "0")}</span>
        <Badge variant={topic.level === "basic" ? "primary" : "secondary"}>{topic.level === "basic" ? "기초" : "중급"}</Badge>
      </div>
      <h1 class="mt-5 text-4xl font-bold tracking-tight sm:text-6xl">{topic.title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-muted-foreground">{topic.summary}</p>
      <div class="mt-6 flex flex-wrap gap-2">{topic.tags.map((tag) => <Badge variant="outline">{tag}</Badge>)}</div>
    </header>

    <TopicDetail {topic} />
  </main>

  <SiteFooter message="정답을 외우는 대신, 선택의 근거를 익혀보세요." linkHref={topicsUrl} linkLabel="다른 유형 살펴보기 →" />
  <script src="../../scripts/detail.ts"></script>
</BaseLayout>

---
import TopicDetail from "../../components/TopicDetail.astro";
import { topics, type Topic } from "../../data/topics";
import "../../styles.css";

export function getStaticPaths() {
  return topics.map((topic, index) => ({
    params: { id: topic.id },
    props: { topic, index },
  }));
}

interface Props {
  topic: Topic;
  index: number;
}

const { topic, index } = Astro.props;
const homeUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const topicsUrl = `${homeUrl}#topics`;
const routeUrl = `${homeUrl}#study-route`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${topic.title} 대표 문제와 단계별 풀이, 코드 템플릿을 확인하세요.`} />
    <title>{topic.title} 대표 문제 | Algo Roadmap</title>
  </head>
  <body>
    <a class="skip-link" href="#topic-content">상세 풀이로 건너뛰기</a>

    <header class="site-header">
      <a class="brand" href={homeUrl} aria-label="Algo Roadmap 홈">
        <span class="brand-mark" aria-hidden="true">A</span>
        <span>Algo Roadmap</span>
      </a>
      <nav aria-label="주요 메뉴">
        <a href={topicsUrl}>유형 학습</a>
        <a href={routeUrl}>추천 순서</a>
      </nav>
    </header>

    <main id="topic-content" class="detail-page">
      <a class="detail-back" href={topicsUrl}>← 대표 문제 유형으로 돌아가기</a>

      <header class="topic-page-header">
        <div class="topic-page-meta">
          <span class="topic-number">{String(index + 1).padStart(2, "0")}</span>
          <span class="level-badge">{topic.level === "basic" ? "기초" : "중급"}</span>
        </div>
        <h1>{topic.title}</h1>
        <p>{topic.summary}</p>
        <div class="topic-tags">
          {topic.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </header>

      <TopicDetail {topic} />
    </main>

    <footer>
      <p>정답을 외우는 대신, 선택의 근거를 익혀보세요.</p>
      <a href={topicsUrl}>다른 유형 살펴보기 →</a>
    </footer>

    <script src="../../scripts/detail.ts"></script>
  </body>
</html>

---
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "@/components/starwind/accordion";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/starwind/card";
import { Checkbox } from "@/components/starwind/checkbox";
import { Progress } from "@/components/starwind/progress";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { conceptCount, csModules } from "../data/csModules";
import BaseLayout from "../layouts/BaseLayout.astro";

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const weeks = [
  ["W01", "데이터 표현 + 복잡도", "숫자 실험과 배열 성능 측정", "결과 차이를 3분 설명하고 측정 기록을 남깁니다."],
  ["W02", "CPU + 프로세스·스레드", "프로세스 관찰과 실행 방식 비교", "CPU·I/O 작업의 실행 방식을 근거와 함께 고릅니다."],
  ["W03", "동시성 + 메모리·I/O", "race condition 재현과 스트리밍", "잠금 전후 결과와 파일 읽기 메모리를 측정합니다."],
  ["W04", "네트워크 + 웹 + 실패", "한 API 요청의 전 구간과 재시도 추적", "timeout·jitter·중복 방지 정책을 포함한 호출 흐름을 그립니다."],
  ["W05", "SQL + 인덱스", "작은 스키마와 쿼리 플랜 분석", "인덱스 전후 플랜과 join 행 수를 비교합니다."],
  ["W06", "트랜잭션 + 캐시", "부분 실패와 오래된 데이터 실험", "트랜잭션 경계와 캐시 무효화 정책을 문서화합니다."],
  ["W07", "설계 + 테스트", "AI 생성 코드의 계약과 테스트 작성", "정상·경계·오류·불변식 테스트가 있는 작은 모듈을 만듭니다."],
  ["W08", "관측성 + 보안", "요청 추적과 역할별 권한표 작성", "민감정보 없는 로그와 거부되어야 할 요청 목록을 만듭니다."],
  ["W09", "AI 파이프라인 + 평가", "검색·도구 경계와 slice별 평가셋 완성", "품질·비용·지연·안전 기준과 롤백 조건을 수치로 정합니다."],
];
---

<BaseLayout
  title="CS Foundations — AI 시대의 기본기 | Algo Roadmap"
  description="AI 시대의 개발자에게 꼭 필요한 컴퓨터 구조, 운영체제, 네트워크, 데이터베이스, 소프트웨어 설계, 보안을 체계적으로 학습하세요."
  skipHref="#curriculum"
  skipLabel="CS 학습 과정으로 건너뛰기"
>
  <SiteHeader page="cs" />

  <main>
    <section class="mx-auto grid w-[calc(100%_-_2rem)] max-w-7xl gap-10 py-20 sm:w-[calc(100%_-_2.5rem)] lg:grid-cols-[minmax(0,1.3fr)_minmax(340px,0.7fr)] lg:items-center lg:py-28">
      <div>
        <p class="text-xs font-bold tracking-[0.12em] text-primary-accent uppercase">Computer science, still essential</p>
        <h1 class="mt-5 text-4xl leading-tight font-bold tracking-tight text-balance sm:text-6xl">AI가 코드를 써도,<br /><span class="text-primary">판단은 기본기</span>에서 나옵니다.</h1>
        <p class="mt-6 max-w-3xl text-base leading-8 text-muted-foreground sm:text-lg">CS는 외울 지식의 목록이 아니라 시스템이 왜 느리고, 틀리고, 멈추고, 위험해지는지 추론하는 도구입니다. 아래 순서대로 개념을 익히고 작은 실습으로 확인하세요.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button as="a" href="#curriculum" variant="primary">커리큘럼 시작하기</Button>
          <Button as="a" href="#study-plan" variant="outline">9주 경로 먼저 보기</Button>
        </div>
      </div>

      <Card class="border-primary/20 shadow-xl shadow-primary/5">
        <CardHeader>
          <p class="text-xs font-bold tracking-[0.12em] text-primary-accent uppercase">학습 영역 지도</p>
          <CardTitle class="mt-2">판단과 검증을 위한 6개 영역</CardTitle>
        </CardHeader>
        <CardContent>
          <ol class="grid gap-2">
            {csModules.map((module) => (
              <li><a class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition-colors hover:bg-muted hover:text-primary" href={`#${module.id}`}><span class="font-mono text-xs text-muted-foreground">{module.number}</span><strong>{module.title}</strong></a></li>
            ))}
          </ol>
        </CardContent>
      </Card>
    </section>

    <section class="border-y border-border bg-muted/45">
      <div class="mx-auto grid w-[calc(100%_-_2rem)] max-w-7xl divide-y divide-border sm:w-[calc(100%_-_2.5rem)] md:grid-cols-3 md:divide-x md:divide-y-0">
        {[
          ["01", "생성보다 검증", "코드는 빨리 만들 수 있어도 정확성·복잡도·보안은 스스로 판단해야 합니다."],
          ["02", "증상보다 원인", "오류 메시지 뒤의 메모리, 네트워크, 동시성 원인을 계층별로 좁힙니다."],
          ["03", "도구보다 원리", "프레임워크가 바뀌어도 남는 원리로 새 기술을 더 빠르게 배웁니다."],
        ].map(([number, title, copy]) => (
          <article class="py-8 md:px-8 first:md:pl-0 last:md:pr-0"><span class="font-mono text-xs font-semibold text-primary">{number}</span><h2 class="mt-3 font-semibold">{title}</h2><p class="mt-2 text-sm leading-6 text-muted-foreground">{copy}</p></article>
        ))}
      </div>
    </section>

    <section class="mx-auto w-[calc(100%_-_2rem)] max-w-7xl py-16 sm:w-[calc(100%_-_2.5rem)]">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div><p class="text-xs font-bold tracking-[0.12em] text-primary-accent uppercase">Dependency map</p><h2 class="mt-3 text-3xl font-bold tracking-tight">위에서 아래로 연결하세요</h2></div>
        <p class="max-w-xl leading-7 text-muted-foreground">앞 영역의 개념이 뒤 영역의 판단 근거가 됩니다. 완벽하게 끝내기보다 한 바퀴 돌고 프로젝트에서 반복하세요.</p>
      </div>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-6">
        {csModules.map((module, index) => (
          <a class="group rounded-xl border border-border bg-card p-4 transition-all hover:-translate-y-1 hover:border-primary/40 hover:shadow-md" href={`#${module.id}`}>
            <span class="font-mono text-xs text-primary">{module.number}</span><strong class="mt-2 block text-sm">{module.title}</strong>{index < csModules.length - 1 && <span class="mt-3 block text-muted-foreground group-hover:text-primary" aria-hidden="true">→</span>}
          </a>
        ))}
      </div>
    </section>

    <div class="mx-auto grid w-[calc(100%_-_2rem)] max-w-7xl gap-8 py-8 sm:w-[calc(100%_-_2.5rem)] lg:grid-cols-[280px_minmax(0,1fr)]">
      <aside class="lg:sticky lg:top-24 lg:h-fit">
        <Card>
          <CardHeader>
            <p class="text-xs font-bold tracking-[0.12em] text-primary-accent uppercase">Your progress</p>
            <div class="mt-2 flex items-center justify-between"><CardTitle>학습 현황</CardTitle><strong id="cs-progress-count" class="font-mono text-primary">0 / {conceptCount}</strong></div>
          </CardHeader>
          <CardContent class="space-y-4">
            <Progress id="cs-progress-track" value={0} max={conceptCount} variant="primary" label="CS 학습 진도" />
            <p id="cs-progress-copy" class="text-sm leading-6 text-muted-foreground">한 번에 하나씩, 직접 설명할 수 있을 때 체크하세요.</p>
            <Button id="cs-reset" type="button" variant="ghost" size="sm" class="px-0 text-muted-foreground">진도 초기화</Button>
            <div class="border-t border-border pt-4">
              <span class="text-xs font-semibold text-muted-foreground">CURRICULUM</span>
              <nav class="mt-2 grid" aria-label="CS 커리큘럼">
                {csModules.map((module) => <a class="rounded-md px-2 py-1.5 text-sm hover:bg-muted hover:text-primary" href={`#${module.id}`}><b class="mr-2 font-mono text-xs">{module.number}</b>{module.title}</a>)}
              </nav>
            </div>
          </CardContent>
        </Card>
      </aside>

      <section id="curriculum" class="grid scroll-mt-24 gap-8" aria-label="CS 기본기 커리큘럼">
        {csModules.map((module) => (
          <article id={module.id} class="scroll-mt-24 rounded-2xl border border-border bg-card p-5 sm:p-7">
            <header class="flex gap-4 border-b border-border pb-6">
              <Badge variant="primary" size="lg" class="h-fit">{module.number}</Badge>
              <div><p class="text-xs font-bold tracking-[0.12em] text-primary-accent uppercase">Foundation module</p><h2 class="mt-2 text-2xl font-bold">{module.title}</h2><p class="mt-2 text-sm leading-6 text-muted-foreground">{module.description}</p></div>
            </header>
            <div class="my-6 rounded-xl bg-primary/5 p-5"><span class="text-xs font-semibold text-primary">이 모듈을 마치면</span><strong class="mt-2 block leading-7">{module.outcome}</strong></div>

            <Accordion type="multiple" defaultValue={module.number === "01" ? [module.concepts[0].id] : []} class="grid gap-3">
              {module.concepts.map((concept, conceptIndex) => (
                <AccordionItem value={concept.id} class="rounded-xl border border-border px-5 data-[completed=true]:border-[color-mix(in_oklab,var(--success)_55%,var(--border))]" data-cs-concept data-completed="false">
                  <AccordionTrigger class="gap-4 py-5 hover:no-underline">
                    <span class="font-mono text-xs text-primary">{module.number}.{conceptIndex + 1}</span>
                    <span class="min-w-0 flex-1 text-left"><strong class="block">{concept.title}</strong><small class="mt-1 block font-normal text-muted-foreground">{concept.subtitle}</small></span>
                  </AccordionTrigger>
                  <AccordionContent>
                    <div class="grid gap-5 border-t border-border pt-5">
                      <div class="grid gap-4 md:grid-cols-2">
                        <div class="rounded-lg bg-muted p-4"><span class="text-xs font-semibold text-primary">핵심 원리</span><p class="mt-2 text-sm leading-6">{concept.core}</p></div>
                        <div class="rounded-lg bg-primary/5 p-4"><span class="text-xs font-semibold text-primary">AI 시대의 연결점</span><p class="mt-2 text-sm leading-6">{concept.aiWhy}</p></div>
                      </div>
                      <div class="grid gap-4 md:grid-cols-2">
                        <div><span class="text-xs font-semibold text-muted-foreground">스스로 답할 질문</span><ul class="mt-3 grid list-disc gap-2 pl-5 text-sm leading-6">{concept.questions.map((question) => <li>{question}</li>)}</ul></div>
                        <div><span class="text-xs font-semibold text-muted-foreground">실습하기</span><p class="mt-3 text-sm leading-6">{concept.practice}</p></div>
                      </div>

                      <Accordion type="single" collapsible>
                        <AccordionItem value="answers" class="rounded-lg border border-border px-4">
                          <AccordionTrigger class="py-4 text-sm">스스로 답할 질문의 정답</AccordionTrigger>
                          <AccordionContent>
                            <ol class="grid gap-3 border-t border-border pt-4">
                              {concept.answers.map((answer, answerIndex) => <li class="flex gap-3 text-sm leading-6"><Badge variant="secondary" size="sm" class="h-fit shrink-0">{answerIndex + 1}</Badge><p>{answer}</p></li>)}
                            </ol>
                          </AccordionContent>
                        </AccordionItem>
                      </Accordion>

                      {concept.references && (
                        <div><span class="text-xs font-semibold text-muted-foreground">공식 근거</span><ul class="mt-2 flex flex-wrap gap-2">{concept.references.map((reference) => <li><a class="text-sm font-medium text-primary hover:underline" href={reference.url} target="_blank" rel="noopener noreferrer">{reference.title} ↗</a></li>)}</ul></div>
                      )}

                      <div class="flex items-start gap-3 rounded-lg border border-border bg-muted/50 p-4">
                        <Checkbox id={`cs-check-${concept.id}`} variant="success" data-cs-check={concept.id} aria-label={`${concept.title} 학습 완료`} />
                        <label for={`cs-check-${concept.id}`} class="cursor-pointer"><b class="block text-sm">학습 완료</b><small class="mt-1 block leading-5 text-muted-foreground">{concept.checkpoint}</small></label>
                      </div>
                    </div>
                  </AccordionContent>
                </AccordionItem>
              ))}
            </Accordion>
          </article>
        ))}
      </section>
    </div>

    <section id="study-plan" class="mt-20 scroll-mt-24 border-y border-border bg-muted/40 py-20">
      <div class="mx-auto grid w-[calc(100%_-_2rem)] max-w-7xl gap-10 sm:w-[calc(100%_-_2.5rem)] lg:grid-cols-[0.7fr_1.3fr]">
        <div><p class="text-xs font-bold tracking-[0.12em] text-primary-accent uppercase">9-week field guide</p><h2 class="mt-3 text-3xl leading-tight font-bold tracking-tight sm:text-4xl">시간 비중은 읽기 30%,<br />실습 60%, 설명 10%</h2><p class="mt-5 leading-7 text-muted-foreground">하루 60~90분, 주 3회를 기준으로 합니다. 세 번째 학습일에는 이전 주 내용을 3분 설명한 뒤 새 실습을 시작합니다.</p></div>
        <ol class="grid gap-3">
          {weeks.map(([week, title, practice, done]) => (
            <li class="grid gap-3 rounded-xl border border-border bg-card p-5 sm:grid-cols-[60px_1fr]">
              <span class="font-mono text-sm font-semibold text-primary">{week}</span><div><strong>{title}</strong><p class="mt-1 text-sm">{practice}</p><small class="mt-2 block leading-5 text-muted-foreground">완료: {done}</small></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="mx-auto w-[calc(100%_-_2rem)] max-w-7xl py-20 text-center sm:w-[calc(100%_-_2.5rem)]"><p class="text-xs font-bold tracking-[0.12em] text-primary-accent uppercase">Final check</p><h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-5xl">“설명할 수 있는가?”가<br />진짜 완료 기준입니다.</h2><div class="mt-8 flex flex-wrap justify-center gap-3">{["① 그림 없이 3분 설명", "② 작은 코드로 재현", "③ 실제 장애와 연결"].map((item) => <Badge variant="outline" size="lg">{item}</Badge>)}</div><Button as="a" href="#curriculum" variant="primary" class="mt-8">첫 개념부터 시작하기 ↑</Button></section>
  </main>

  <SiteFooter message="도구는 바뀌어도, 시스템을 보는 눈은 남습니다." note="콘텐츠 마지막 검토: 2026-08-04 · 각 개념의 공식 근거 링크는 본문에 표시했습니다." linkHref={baseUrl} linkLabel="Algo Roadmap 홈으로 →" />
  <script src="../scripts/cs.ts"></script>
</BaseLayout>

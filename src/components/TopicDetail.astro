---
import { Badge } from "@/components/starwind/badge";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/starwind/card";
import type { Topic } from "../data/topics";
import { examples } from "../data/examples";
import ExampleWalkthrough from "./ExampleWalkthrough.astro";

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
const example = examples[topic.id];

if (!example) {
  throw new Error(`${topic.id} 유형의 대표 문제가 없습니다.`);
}
---

<article class="grid gap-6">
  <Card>
    <CardHeader><CardTitle>이 신호를 찾으세요</CardTitle></CardHeader>
    <CardContent><ul class="mt-4 grid list-disc gap-2.5 pl-[1.35rem]">{topic.signals.map((item) => <li>{item}</li>)}</ul></CardContent>
  </Card>

  <div class="grid gap-6 lg:grid-cols-2">
    <Card>
      <CardHeader><CardTitle>적용 조건</CardTitle></CardHeader>
      <CardContent><ul class="mt-4 grid list-disc gap-2.5 pl-[1.35rem]">{topic.preconditions.map((item) => <li>{item}</li>)}</ul></CardContent>
    </Card>
    <Card class="border-warning/70 bg-warning/5">
      <CardHeader><CardTitle>이 방법이 맞지 않는 경우</CardTitle></CardHeader>
      <CardContent><ul class="mt-4 grid list-disc gap-2.5 pl-[1.35rem]">{topic.doesNotApply.map((item) => <li>{item}</li>)}</ul></CardContent>
    </Card>
  </div>

  <ExampleWalkthrough {example} />

  <div class="grid gap-6 lg:grid-cols-2">
    <Card>
      <CardHeader><CardTitle>풀이 순서</CardTitle></CardHeader>
      <CardContent><ol class="mt-4 grid list-decimal gap-2.5 pl-[1.35rem]">{topic.steps.map((item) => <li>{item}</li>)}</ol></CardContent>
    </Card>
    <Card>
      <CardHeader class="flex-row items-center justify-between">
        <CardTitle>복잡도</CardTitle>
        <Badge variant="primary">{topic.complexity}</Badge>
      </CardHeader>
      <CardContent><ul class="mt-4 grid list-disc gap-2.5 pl-[1.35rem]">{topic.complexityNotes.map((item) => <li>{item}</li>)}</ul></CardContent>
    </Card>
  </div>

  <Card>
    <CardHeader><CardTitle>자주 하는 실수</CardTitle></CardHeader>
    <CardContent><p class="leading-7 text-muted-foreground">{topic.mistake}</p></CardContent>
  </Card>

  <Card>
    <CardHeader><CardTitle>연습 문제</CardTitle></CardHeader>
    <CardContent>
      <ul class="divide-y divide-border">
        {topic.problems.map(({ name, difficulty, url, relation, note }) => (
          <li>
            <a class="flex items-center justify-between gap-4 py-4 transition-colors hover:text-primary" href={url} target="_blank" rel="noopener noreferrer">
              <span>
                <strong class="block">{name}</strong>
                <span class="mt-1 block text-sm text-muted-foreground">{note ?? relation}</span>
              </span>
              <Badge variant="outline" class="shrink-0">{difficulty} ↗</Badge>
            </a>
          </li>
        ))}
      </ul>
    </CardContent>
  </Card>
</article>

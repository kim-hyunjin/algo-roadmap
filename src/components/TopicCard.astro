---
import type { Topic } from "../data/topics";
import ExampleWalkthrough from "./ExampleWalkthrough.astro";
import { examples } from "../data/examples";

interface Props {
  topic: Topic;
  index: number;
}

const { topic, index } = Astro.props;
const example = examples[topic.id];

if (!example) {
  throw new Error(`${topic.id} 유형의 대표 문제가 없습니다.`);
}
const searchText = [topic.title, topic.summary, ...topic.tags, ...topic.signals]
  .join(" ")
  .toLocaleLowerCase("ko");
---

<article
  class="topic-card"
  data-topic-card
  data-id={topic.id}
  data-level={topic.level}
  data-search={searchText}
>
  <div class="topic-card-header">
    <div>
      <span class="topic-number">{String(index + 1).padStart(2, "0")}</span>
      <span class="level-badge">{topic.level === "basic" ? "기초" : "중급"}</span>
    </div>
    <label class="complete-toggle">
      <input type="checkbox" aria-label={`${topic.title} 학습 완료`} />
      <span>학습 완료</span>
    </label>
  </div>

  <h3>{topic.title}</h3>
  <p class="topic-summary">{topic.summary}</p>
  <div class="topic-tags">
    {topic.tags.map((tag) => <span>{tag}</span>)}
  </div>

  <button class="open-topic" type="button" aria-expanded="false">
    <span data-open-label>대표 문제로 자세히 보기</span>
    <span data-open-icon aria-hidden="true">＋</span>
  </button>

  <div class="topic-detail" hidden>
    <div class="detail-block">
      <h4>이 신호를 찾으세요</h4>
      <ul>{topic.signals.map((item) => <li>{item}</li>)}</ul>
    </div>
    <ExampleWalkthrough {example} />
    <div class="detail-block" data-code-tabs>
      <h4>풀이 순서</h4>
      <ol>{topic.steps.map((item) => <li>{item}</li>)}</ol>
    </div>
    <div class="detail-block">
      <h4>복잡도</h4>
      <span class="complexity">{topic.complexity}</span>
    </div>
    <div class="detail-block">
      <h4>자주 하는 실수</h4>
      <p>{topic.mistake}</p>
    </div>
    <div class="detail-block">
      <h4>기본 템플릿</h4>
      <div class="code-tabs" role="tablist" aria-label={`${topic.title} 코드 언어`}>
        <button
          class="code-tab active"
          type="button"
          role="tab"
          aria-selected="true"
          data-language="python"
        >Python</button>
        <button
          class="code-tab"
          type="button"
          role="tab"
          aria-selected="false"
          data-language="javascript"
        >JavaScript</button>
      </div>
      <pre data-code-language="python"><code>{topic.python}</code></pre>
      <pre data-code-language="javascript" hidden><code>{topic.javascript}</code></pre>
    </div>
    <div class="detail-block">
      <h4>연습 문제</h4>
      <ul class="problem-list">
        {topic.problems.map(([name, difficulty, url]) => (
          <li>
            <a href={url} target="_blank" rel="noopener noreferrer">
              <span>{name}</span><small>{difficulty} ↗</small>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</article>

---
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { Card, CardContent, CardFooter, CardHeader, CardTitle } from "@/components/starwind/card";
import { Checkbox } from "@/components/starwind/checkbox";
import type { Topic } from "../data/topics";

interface Props {
  topic: Topic;
  index: number;
}

const { topic, index } = Astro.props;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const detailUrl = `${baseUrl}topics/${topic.id}/`;
const searchText = [
  topic.title,
  topic.summary,
  ...topic.tags,
  ...topic.signals,
  ...topic.preconditions,
  ...topic.doesNotApply,
]
  .join(" ")
  .toLocaleLowerCase("ko");
---

<Card
  class="flex h-full flex-col transition-all duration-200 hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg data-[completed=true]:border-[color-mix(in_oklab,var(--success)_65%,var(--border))] data-[completed=true]:bg-[color-mix(in_oklab,var(--success)_8%,var(--card))]"
  data-topic-card
  data-id={topic.id}
  data-level={topic.level}
  data-search={searchText}
  data-completed="false"
>
  <CardHeader class="gap-4">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="font-mono text-xs font-semibold text-muted-foreground">{String(index + 1).padStart(2, "0")}</span>
        <Badge variant={topic.level === "basic" ? "primary" : "secondary"} size="sm">
          {topic.level === "basic" ? "기초" : "중급"}
        </Badge>
      </div>
      <div class="flex items-center gap-2">
        <Checkbox
          id={`topic-complete-${topic.id}`}
          aria-label={`${topic.title} 학습 완료`}
          variant="success"
          size="sm"
          data-topic-complete
        />
        <span class="text-xs text-muted-foreground">완료</span>
      </div>
    </div>
    <CardTitle class="text-xl">{topic.title}</CardTitle>
  </CardHeader>

  <CardContent class="flex flex-1 flex-col gap-5">
    <p class="text-sm leading-6 text-muted-foreground">{topic.summary}</p>
    <div class="flex flex-wrap gap-1.5">
      {topic.tags.map((tag) => <Badge variant="outline" size="sm">{tag}</Badge>)}
    </div>
  </CardContent>

  <CardFooter>
    <Button as="a" href={detailUrl} variant="outline" size="sm" class="w-full justify-between">
      <span>대표 문제로 자세히 보기</span>
      <span aria-hidden="true">→</span>
    </Button>
  </CardFooter>
</Card>
